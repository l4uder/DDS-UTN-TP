<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence
             http://java.sun.com/xml/ns/persistence/persistence_2_0.xsd" version="2.0">

    <persistence-unit name="simple-persistence-unit" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.donante.Donante</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.donante.tipodonantes.juridica.Juridica</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.donante.tipodonantes.persona.Humana</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.donante.tipodonantes.juridica.Representante</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.mediocontacto.MedioContacto</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.donante.entrega.RegistroEntrega</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.bien.Bien</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.bien.Subcategoria</class>
        <class>ar.edu.utn.frba.dds.donatrack.donaciones.dominio.bien.Categoria</class>
        <properties>
            <property name="hibernate.connection.driver_class" value="org.hsqldb.jdbcDriver"/>
            <property name="hibernate.connection.url" value="jdbc:hsqldb:mem:donaciones-db"/>
            <property name="hibernate.connection.username" value=""/>
            <property name="hibernate.connection.password" value=""/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.HSQLDialect"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="use_sql_comments" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="create-drop"/>
        </properties>
    </persistence-unit>
</persistence>